<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Clock_Watch_Time_Manager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Clock_Watch_Time_Manager"
    Title="Clock Watch Time Manager">

    <TabBar>
        <ShellContent
            Title="Time Clock"
            ContentTemplate="{DataTemplate local:Views.CreateTimeCardPage}"
            Route="CreateTimeCardPage"/>
        <ShellContent
            Title="Catalog"
            ContentTemplate="{DataTemplate local:Views.ShowTimeCardsPage}"
            Route="ShowTimeCardPage"/>
    </TabBar>

</Shell>
