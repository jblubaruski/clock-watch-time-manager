<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clock_Watch_Time_Manager.Views.CreateTimeCardPage"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout>
        <!-- time card - top bar separator -->
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="0" Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,2"/>
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="1" Grid.Column="0"
            Grid.ColumnSpan="3"/>

        <!-- time card header layout -->
        <Grid
            RowDefinitions="30,Auto,Auto"
            ColumnDefinitions="150,150,150"
            Padding="5,10,5,5">

            <!-- time card header buttons -->
            <Button
                Text="Clock In"
                Style="{StaticResource buttonStyle}"
                Grid.Row="0" Grid.Column="0"/>
            <Button
                Text="Clock Out"
                Style="{StaticResource buttonStyle}"
                Grid.Row="0" Grid.Column="1"
                Margin="5,0,0,0"/>
            <Label
                Text="Time Card Saved!"
                Style="{StaticResource labelStyle}"
                Margin="5,0,0,0"
                VerticalOptions="Center"
                IsVisible="True"
                Grid.Row="0" Grid.Column="2"/>

            <!-- clock in time info -->
            <Label
                Text="Clock In Time:"
                HorizontalTextAlignment="End"
                Style="{StaticResource labelStyle}"
                Margin="5,5,0,0"
                Grid.Row="1" Grid.Column="0"/>
            <HorizontalStackLayout
                Grid.Row="1" Grid.Column="1"
                Grid.ColumnSpan="2">
                <Label
                    Text="{StaticResource default12HourTime}"
                    Style="{StaticResource labelStyle}"
                    WidthRequest="100"
                    Margin="5,5,0,0"/>
                <Label
                    Text="{StaticResource defaultDate}"
                    Style="{StaticResource labelStyle}"
                    Margin="5,5,0,0"/>
            </HorizontalStackLayout>

            <!-- work period duration info -->
            <Label
                Text="Time Since Clock In:"
                HorizontalTextAlignment="End"
                Style="{StaticResource labelStyle}"
                Margin="0,5,0,0"
                Grid.Row="2" Grid.Column="0"/>
            <Label
                Text="{StaticResource defaultTimeDuration}"
                Style="{StaticResource labelStyle}"
                Margin="5,5,0,0"
                Grid.Row="2" Grid.Column="1"
                Grid.ColumnSpan="2"/>
        </Grid>

        <!-- header - timesheet separator -->
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="1" Grid.Column="0"
            Grid.ColumnSpan="3"/>

        <!-- timesheet layout -->
        <Grid
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto"
            Padding="5,10,5,0">

            <!-- break controls -->
            <HorizontalStackLayout
                Grid.Row="0" Grid.Column="0">

                <Button
                    Text="Start Break"
                    WidthRequest="135"
                    Style="{StaticResource buttonStyle}"/>
                <Button
                    Text="End Break"
                    WidthRequest="135"
                    Margin="5,0,0,0"
                    Style="{StaticResource buttonStyle}"/>
                <Label
                    Text="Break Saved!"
                    Margin="5,0,0,0"
                    VerticalOptions="Center"
                    IsVisible="True"
                    Style="{StaticResource labelStyle}"/>
            </HorizontalStackLayout>

            <!-- break display -->
            <ScrollView
                Grid.Row="1" Grid.Column="0"
                Margin="0,10,0,0">

                <!-- example break info -->
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="80,100,230">
                    
                    <!-- top border -->
                    <BoxView
                        Style="{StaticResource horizontalSeparatorStyle}"
                        Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="3"/>

                    <!-- start time -->
                    <Label
                        Text="Start Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="1" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource default12HourTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="1" Grid.Column="1"/>
                    <Label
                        Text="{StaticResource defaultDate}"
                        Style="{StaticResource labelStyle}"
                        Margin="10,5,0,0"
                        Grid.Row="1" Grid.Column="2"/>

                    <!-- end time -->
                    <Label
                        Text="End Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="2" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource default12HourTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="2" Grid.Column="1"/>
                    <Label
                        Text="{StaticResource defaultDate}"
                        Style="{StaticResource labelStyle}"
                        Margin="10,5,0,0"
                        Grid.Row="2" Grid.Column="2"/>

                    <!-- description -->
                    <Border
                        Stroke="Black"
                        StrokeThickness="1"
                        Padding="2,0,0,0"
                        Grid.Row="3" Grid.Column="0"
                        Grid.ColumnSpan="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4,4,4,4"/>
                        </Border.StrokeShape>
                        <Label
                            Text="{StaticResource stringM160Char}"
                            Style="{StaticResource descriptionLabelStyle}"
                            VerticalTextAlignment="Center"
                            WidthRequest="410"/>
                    </Border>
                    <Button
                        Text="Edit Break Description"
                        Style="{StaticResource buttonStyle}"
                        WidthRequest="275"
                        HorizontalOptions="Start"
                        Margin="0,5,0,0"
                        Grid.Row="4" Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                </Grid>
            </ScrollView>

            <!-- breaks - tasks separator -->
            <BoxView
                Style="{StaticResource verticalSeparatorStyle}"
                Margin="5,0"
                Grid.Row="0" Grid.Column="1"
                Grid.RowSpan="2"/>

            <!-- task controls -->
            <HorizontalStackLayout
                Grid.Row="0" Grid.Column="2">

                <Button
                    Text="Start Task"
                    WidthRequest="135"
                    Style="{StaticResource buttonStyle}"/>
                <Button
                    Text="End Task"
                    WidthRequest="135"
                    Margin="5,0,0,0"
                    Style="{StaticResource buttonStyle}"/>
                <Label
                    Text="Task Saved!"
                    Margin="5,0,0,0"
                    VerticalOptions="Center"
                    IsVisible="True"
                    Style="{StaticResource labelStyle}"/>
            </HorizontalStackLayout>

            <!-- task display -->
            <ScrollView
                Grid.Row="1" Grid.Column="2"
                Margin="0,10,0,0">

                <!-- example task info -->
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="80,100,230">

                    <!-- top border -->
                    <BoxView
                        Style="{StaticResource horizontalSeparatorStyle}"
                        Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="3"/>

                    <!-- start time -->
                    <Label
                        Text="Start Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="1" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource default12HourTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="1" Grid.Column="1"/>
                    <Label
                        Text="{StaticResource defaultDate}"
                        Style="{StaticResource labelStyle}"
                        Margin="10,5,0,0"
                        Grid.Row="1" Grid.Column="2"/>

                    <!-- end time -->
                    <Label
                        Text="End Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="2" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource default12HourTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="2" Grid.Column="1"/>
                    <Label
                        Text="{StaticResource defaultDate}"
                        Style="{StaticResource labelStyle}"
                        Margin="10,5,0,0"
                        Grid.Row="2" Grid.Column="2"/>

                    <!-- description -->
                    <Border
                        Stroke="Black"
                        Padding="2,0,0,0"
                        Grid.Row="3" Grid.Column="0"
                        Grid.ColumnSpan="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4,4,4,4"/>
                        </Border.StrokeShape>
                        <Label
                            Text="{StaticResource stringM160Char}"
                            Style="{StaticResource descriptionLabelStyle}"
                            VerticalTextAlignment="Center"
                            WidthRequest="410"
                            Grid.Row="3" Grid.Column="0"
                            Grid.ColumnSpan="3"/>
                    </Border>
                    <Button
                        Text="Edit Break Description"
                        Style="{StaticResource buttonStyle}"
                        WidthRequest="275"
                        HorizontalOptions="Start"
                        Margin="0,5,0,0"
                        Grid.Row="4" Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                </Grid>
            </ScrollView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
