<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ClockWatchTimeManager"
             x:Class="ClockWatchTimeManager.App">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- separator styles -->
            <Style x:Key="horizontalSeparatorStyle" TargetType="BoxView">
                <Setter Property="Color" Value="Black"/>
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="HorizontalOptions" Value="Fill"/>
            </Style>
            <Style x:Key="verticalSeparatorStyle" TargetType="BoxView">
                <Setter Property="Color" Value="Black"/>
                <Setter Property="WidthRequest" Value="1"/>
                <Setter Property="VerticalOptions" Value="Fill"/>
            </Style>

            <!-- button styles -->
            <Style x:Key="buttonStyle" TargetType="Button">
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="FontFamily" Value="BAHNSCHRIFT-Regular"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="Beige"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="BorderColor" Value="Black"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="MinimumHeightRequest" Value="20"/>
                <Setter Property="Padding" Value="0,4,0,0"/>
                <Setter Property="VerticalOptions" Value="Fill"/>
            </Style>

            <!-- label styles -->
            <Style x:Key="labelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="BAHNSCHRIFT-Regular"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="descriptionLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="BAHNSCHRIFT-Regular"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="Margin" Value="5"/>
            </Style>
            
            <!-- border styles -->
            <Style x:Key="descriptionBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="Black"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 4,4,4,4"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
            </Style>

            <!-- constants -->
            <x:String x:Key="defaultDateTime">--:--:-- -- -- --------- --- --, ----</x:String>
            <x:String x:Key="defaultTimeDuration">--:--:--</x:String>
            <x:String x:Key="defaultDate">--/--/----</x:String>
            <x:String x:Key="defaultBreakDescription">Break description...</x:String>
            <x:String x:Key="defaultTaskDescription">Task description...</x:String>
            <x:String x:Key="stringM160Char">MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
