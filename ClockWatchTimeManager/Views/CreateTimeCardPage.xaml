<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ClockWatchTimeManager.ViewModels"
             x:Class="ClockWatchTimeManager.Views.CreateTimeCardPage"
             Shell.NavBarIsVisible="False">
    <ContentPage.BindingContext>
        <viewmodel:CreateTimeCardViewModel/>
    </ContentPage.BindingContext>

    <VerticalStackLayout>
        <!-- time card - top bar separator -->
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="0" Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,2"/>
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="1" Grid.Column="0"
            Grid.ColumnSpan="3"/>

        <!-- time card header layout -->
        <Grid
            RowDefinitions="30,Auto,Auto"
            ColumnDefinitions="150,150,150"
            Padding="5,10,5,5">

            <!-- time card header buttons -->
            <Button
                x:Name="clockInButton"
                Text="Clock In"
                Style="{StaticResource buttonStyle}"
                Command="{Binding ClockInCommand}"
                IsEnabled="{Binding ClockInEnabled}"
                Grid.Row="0" Grid.Column="0"/>
            <Button
                x:Name="clockOutButton"
                Text="Clock Out"
                Style="{StaticResource buttonStyle}"
                Command="{Binding ClockOutCommand}"
                IsEnabled="{Binding ClockOutEnabled}"
                Grid.Row="0" Grid.Column="1"
                Margin="5,0,0,0"/>
            <Label
                x:Name="timeCardSavedNotification"
                Text="Time Card Saved!"
                Style="{StaticResource labelStyle}"
                Margin="5,0,0,0"
                VerticalOptions="Center"
                IsVisible="{Binding TimeCardSavedNotifVisible}"
                Grid.Row="0" Grid.Column="2"/>

            <!-- clock in time info -->
            <Label
                Text="Clock In Time:"
                HorizontalTextAlignment="Start"
                Style="{StaticResource labelStyle}"
                Margin="0,5,0,0"
                Grid.Row="1" Grid.Column="0"/>
            <Label
                x:Name="clockInDateTimeLabel"
                Text="{Binding ClockInDateTime}"
                Style="{StaticResource labelStyle}"
                Margin="5,5,0,0"
                Grid.Row="1" Grid.Column="1"
                Grid.ColumnSpan="2"/>

            <!-- work period duration info -->
            <Label
                Text="Time Since Clock In:"
                HorizontalTextAlignment="Start"
                Style="{StaticResource labelStyle}"
                Margin="0,5,0,0"
                Grid.Row="2" Grid.Column="0"/>
            <Label
                Text="{Binding TimeSinceClockIn}"
                Style="{StaticResource labelStyle}"
                Margin="5,5,0,0"
                Grid.Row="2" Grid.Column="1"
                Grid.ColumnSpan="2"/>
        </Grid>

        <!-- header - timesheet separator -->
        <BoxView
            Style="{StaticResource horizontalSeparatorStyle}"
            Grid.Row="1" Grid.Column="0"
            Grid.ColumnSpan="3"/>

        <!-- timesheet layout -->
        <Grid
            x:Name="timesheet"
            RowDefinitions="Auto,Auto,*"
            ColumnDefinitions="460,Auto,460"
            Padding="5,10,5,0">

            <!-- break controls -->
            <HorizontalStackLayout
                Grid.Row="0" Grid.Column="0">

                <Button
                    Text="Start Break"
                    WidthRequest="135"
                    Style="{StaticResource buttonStyle}"/>
                <Button
                    Text="End Break"
                    WidthRequest="135"
                    Margin="5,0,0,0"
                    Style="{StaticResource buttonStyle}"/>
                <Label
                    Text="Break Saved!"
                    Margin="5,0,0,0"
                    VerticalOptions="Center"
                    IsVisible="True"
                    Style="{StaticResource labelStyle}"/>
            </HorizontalStackLayout>

            <!-- break display -->
            <ScrollView
                x:Name="breakDisplay"
                Grid.Row="1" Grid.Column="0"
                Margin="0,10,0,0">

                <!-- example break info -->
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="80,100,280">
                    
                    <!-- top border -->
                    <BoxView
                        Style="{StaticResource horizontalSeparatorStyle}"
                        Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="3"/>

                    <!-- start time -->
                    <Label
                        Text="Start Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="1" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource defaultDateTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="1" Grid.Column="1"
                        Grid.ColumnSpan="2"/>

                    <!-- end time -->
                    <Label
                        Text="End Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="2" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource defaultDateTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="2" Grid.Column="1"
                        Grid.ColumnSpan="2"/>

                    <!-- description -->
                    <Border
                        Style="{StaticResource descriptionBorderStyle}"
                        WidthRequest="415"
                        Grid.Row="3" Grid.Column="0"
                        Grid.ColumnSpan="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4,4,4,4"/>
                        </Border.StrokeShape>
                        <Label
                            Text="{StaticResource defaultBreakDescription}"
                            Style="{StaticResource descriptionLabelStyle}"
                            VerticalTextAlignment="Center"
                            WidthRequest="410"/>
                    </Border>
                    <Button
                        Text="Edit Break Description"
                        Style="{StaticResource buttonStyle}"
                        WidthRequest="275"
                        HorizontalOptions="Start"
                        Margin="0,5,0,0"
                        Grid.Row="4" Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                </Grid>
            </ScrollView>

            <!-- breaks - tasks separator -->
            <BoxView
                Style="{StaticResource verticalSeparatorStyle}"
                Margin="5,0"
                Grid.Row="0" Grid.Column="1"
                Grid.RowSpan="2"/>
            <BoxView
                Style="{StaticResource verticalSeparatorStyle}"
                Margin="5,0"
                HeightRequest="400"
                Grid.Row="2" Grid.Column="1"/>

            <!-- task controls -->
            <HorizontalStackLayout
                Grid.Row="0" Grid.Column="2">

                <Button
                    Text="Start Task"
                    WidthRequest="135"
                    Style="{StaticResource buttonStyle}"/>
                <Button
                    Text="End Task"
                    WidthRequest="135"
                    Margin="5,0,0,0"
                    Style="{StaticResource buttonStyle}"/>
                <Label
                    Text="Task Saved!"
                    Margin="5,0,0,0"
                    VerticalOptions="Center"
                    IsVisible="True"
                    Style="{StaticResource labelStyle}"/>
            </HorizontalStackLayout>

            <!-- task display -->
            <ScrollView
                Grid.Row="1" Grid.Column="2"
                Margin="0,10,0,0">

                <!-- example task info -->
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="80,100,280">

                    <!-- top border -->
                    <BoxView
                        Style="{StaticResource horizontalSeparatorStyle}"
                        Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="3"/>

                    <!-- start time -->
                    <Label
                        Text="Start Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="1" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource defaultDateTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="1" Grid.Column="1"
                        Grid.ColumnSpan="2"/>

                    <!-- end time -->
                    <Label
                        Text="End Time:"
                        Style="{StaticResource labelStyle}"
                        HorizontalOptions="End"
                        Margin="0,5,0,0"
                        Grid.Row="2" Grid.Column="0"/>
                    <Label
                        Text="{StaticResource defaultDateTime}"
                        Style="{StaticResource labelStyle}"
                        Margin="5,5,0,0"
                        Grid.Row="2" Grid.Column="1"
                        Grid.ColumnSpan="2"/>

                    <!-- description -->
                    <Border
                        Style="{StaticResource descriptionBorderStyle}"
                        WidthRequest="415"
                        Grid.Row="3" Grid.Column="0"
                        Grid.ColumnSpan="3">
                        <Label
                            Text="{StaticResource defaultTaskDescription}"
                            Style="{StaticResource descriptionLabelStyle}"
                            WidthRequest="410"/>
                    </Border>
                    <Button
                        Text="Edit Task Description"
                        Style="{StaticResource buttonStyle}"
                        WidthRequest="275"
                        HorizontalOptions="Start"
                        Margin="0,5,0,0"
                        Grid.Row="4" Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                </Grid>
            </ScrollView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
